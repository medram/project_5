{
    "schemaVersion": "1.0.0",
    "id": "admin-content",
    "area": "Administration",
    "name": "Cross-workspace content operations",
    "status": "planned",
    "requirements": [
        {
            "id": "ACNT-1",
            "text": "Authorized administrators can list cross-workspace links, bio pages, folders, domains, overlays, link pages, and pixels.",
            "priority": "P1",
            "status": "planned"
        },
        {
            "id": "ACNT-2",
            "text": "Administration content views show owner/workspace metadata, state, counts, and timestamps but never private destinations or secrets.",
            "priority": "P1",
            "status": "planned"
        },
        {
            "id": "ACNT-3",
            "text": "Administration content access never grants silent impersonation or tenant membership.",
            "priority": "P0",
            "status": "planned"
        }
    ],
    "routes": [
        "/admin/links",
        "/admin/biolinks",
        "/admin/folders",
        "/admin/custom-domains",
        "/admin/link-overlays",
        "/admin/link-pages",
        "/admin/pixels"
    ],
    "dependencies": [
        "admin-users-roles",
        "short-links",
        "folders",
        "bio-pages",
        "custom-domains",
        "overlays",
        "link-pages",
        "tracking-pixels"
    ],
    "externalPrerequisites": [],
    "acceptanceCriteria": [
        {
            "id": "ACNT-AC-1",
            "text": "Cross-owner metadata pages require admin.content.view_metadata."
        },
        {
            "id": "ACNT-AC-2",
            "text": "Destination URLs, webhook URLs/secrets, lead values, visitor hashes, and detailed visitor dimensions never appear."
        }
    ],
