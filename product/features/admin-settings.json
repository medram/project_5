    "acceptanceCriteria": [
        {
            "id": "ASET-AC-1",
            "text": "Every settings field is validated by a section whitelist and every mutation produces a redacted admin audit log."
        },
        {
            "id": "ASET-AC-2",
            "text": "Partially configured external providers remain disabled rather than appearing operational."
        },
        {
            "id": "ASET-AC-3",
            "text": "The reference custom-code screen is treated as a safety divergence and is not reproduced."
        }
    ],
