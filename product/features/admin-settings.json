    "requirements": [
        {
            "id": "ADM-6",
            "text": "Platform administration includes roles, global insights, localization, and site, system, SEO, email, auth, GDPR, and analytics settings.",
            "priority": "P3",
            "status": "in_progress"
        },
        {
            "id": "ASET-1",
            "text": "A typed settings repository accepts only whitelisted fields per section and encrypts secrets while environment security values take precedence.",
            "priority": "P0",
            "status": "verified"
        },
        {
            "id": "ASET-2",
            "text": "Settings drive real site, link, bio, subscription, localization, authentication, upload, email, system, analytics, GDPR, captcha, SEO, ads, and safe brand-verification behavior.",
            "priority": "P1",
            "status": "in_progress"
        },
        {
            "id": "ASET-3",
            "text": "Theme, menu, ad, verification, and branding extensibility is allowlisted; raw HTML, JavaScript, and unrestricted CSS are never stored or rendered.",
            "priority": "P0",
            "status": "verified"
        }
    ],
